{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2020", "DOM", "DOM.Iterable"],
		"baseUrl": ".",
		"esModuleInterop": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"noEmit": true,
		"strict": true,
		"types": ["vitest/globals"]
	},
	"include": ["./src", "vite.config.ts"],
	"exclude": ["node_modules"]
}
